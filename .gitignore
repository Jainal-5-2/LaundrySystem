nbproject/private/
build/
dist/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml

# --- Compiled Java ---
*.class

# --- Logs (optional but recommended) ---
*.log

# --- Your Libraries Folder ---
# Since you manually manage JARs, you likely DO NOT want them in Git.
# Uncomment the next line if you want to ignore the entire folder.
# Libraries/

# If you want to track the folder but ignore specific temporary files inside:
# Libraries/*.tmp